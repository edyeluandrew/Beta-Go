# Copy this file to apps/.env and fill in the blanks.
# The API and the React app both read apps/.env.

# Neon pooled connection string, from the Neon dashboard.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Google OAuth client ID for a Web application.
# Use the same value on both lines. Authorized JavaScript origin: http://localhost:5173
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# At least 32 characters. Replace this before any deployment.
SESSION_SECRET=dev-only-session-secret-change-before-deploy

# Google emails that receive super_admin the first time they sign in.
# Comma-separated. Example: you@gmail.com
BOOTSTRAP_ADMIN_EMAILS=

HTTP_ADDR=:8080
WEB_ORIGIN=http://localhost:5173
ENV=development
COOKIE_SECURE=false
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=336h

# Leave these blank until a live provider is chosen. sandbox is a local stand-in, not MTN or Airtel.
# PAYMENT_PROVIDER=sandbox
# PAYMENT_WEBHOOK_SECRET=
